# ─────────────────────────────────────────────
#  CloudPilot — Environment Configuration
#  Copy this file to .env and fill in values.
#  NEVER commit the actual .env file.
# ─────────────────────────────────────────────

# Application
APP_NAME=CloudPilot
ENVIRONMENT=development

# Database — use service name "postgres" inside Docker
DATABASE_URL=postgresql+asyncpg://cloudpilot:cloudpilot@postgres:5432/cloudpilot

# JWT
JWT_SECRET_KEY=change-me-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Postgres container credentials
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=cloudpilot
POSTGRES_DB=cloudpilot
