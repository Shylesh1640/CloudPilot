# ─────────────────────────────────────────────
#  CloudPilot — Environment Configuration
#  Copy this file to .env and fill in values.
#  NEVER commit the actual .env file.
# ─────────────────────────────────────────────

# Application
APP_NAME=CloudPilot
ENVIRONMENT=development

# Database — use service name "postgres" inside Docker
DATABASE_URL=postgresql+asyncpg://cloudpilot:cloudpilot@postgres:5432/cloudpilot

# JWT
JWT_SECRET_KEY=change-me-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# AI providers. Leave AI_API_KEY empty to use Phase 9's deterministic,
# non-executing incident-analysis fallback.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_INCIDENT_TIMEOUT_SECONDS=15
AI_INCIDENT_MAX_RETRIES=2
AI_INCIDENT_CONTEXT_LOG_LINES=100
AI_INCIDENT_CONTEXT_EVENTS=20
AI_INCIDENT_HISTORY_LIMIT=5

# Postgres container credentials
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=cloudpilot
POSTGRES_DB=cloudpilot
